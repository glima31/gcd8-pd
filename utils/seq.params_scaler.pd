#N canvas 827 239 734 565 12;
#X obj 81 311 expr round($f1 * $f2);
#X obj 113 217 t b b f f;
#X obj 81 147 inlet;
#X obj 217 147 inlet;
#X obj 358 156 inlet;
#X obj 81 350 outlet;
#X obj 259 350 outlet;
#X text 312 122 float: shift (0.0 - 1.0);
#X text 174 122 float: hits (0.0 - 1.0);
#X obj 259 311 expr round(max(0 \, $f1 * ($f2 - 1))) + 0;
#X text 60 122 float: length;
#X text 33 376 float: number of hits corresponding to the hits input value scaled to the input length value, f 20;
#X text 210 376 float: shift value corresponding to the hits input value scaled to the input length value, f 20;
#X text 391 343 ^^^ NOTE: we are adding +0 to get rid of a quirk where '-0' is displayed, f 25;
#X text 60 7 This abstraction takes an arbitrary positive integer representing an euclidean sequence length (N steps) on its first inlet and the 'hits' and 'shift' knob readings (from 0 to 1.0) on the other inlets. It then computes the actual values for 'hits' and 'shift' as integers taking into account the sequence length. This allows our GUI knobs for the hits/shift params to have a static range of 0.0-1.0.;
#X connect 0 0 5 0;
