#X obj 172 353 expr ($f2 + 2 * ceil(($f1 - $f2) / 2 - 0.0001) - $f1) * 60000 / $f3;
#X text 654 276 <--- the first time a non-0 BPM value is received: \; 1 set the clock to external mode \; 2 send the BPM value to the clock \;, f 42;
#X text 773 361 <--- only set the clock to DAW mode on the first time we receive a non-0 BPM value. this makes it possible to switch to internal mode if we please \, even when inside a DAW., f 25;
